{
  "name": "streamio-v2",
  "version": "2.1.1",
  "description": "Self-hosted streaming platform for your own media library.",
  "main": "index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/streamio-org/streamio-website.git"
  },
  "scripts": {
    "prebuild": "rm -rf dist",
    "build": "tsc && npm run build:frontend",
    "build:frontend": "npm run typecheck:frontend && vite build --config frontend/vite.config.ts",
    "start": "node dist/index.js",
    "watch": "tsc --watch",
    "dev": "nodemon dist/index.js",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "stop": "for p in $(pgrep -f '^[^ ]*node dist/index\\.js$'); do [ \"$(readlink /proc/$p/cwd)\" = \"$PWD\" ] && kill $p; done; true",
    "logs": "docker compose logs -f --tail=200 streamio",
    "test:providers": "npm run build && node tests/providers.test.mjs",
    "test:genres": "npm run build && node tests/genres.test.mjs",
    "test:device-login": "npm run build && node tests/device-login.test.mjs",
    "test:ssrf": "npm run build && node tests/ssrf.test.mjs",
    "test:og": "npm run build && node tests/og-meta.test.mjs",
    "typecheck:frontend": "tsc -p frontend && tsc -p frontend/tsconfig.node.json",
    "test:frontend": "vitest run --config frontend/vite.config.ts",
    "release": "bash scripts/release.sh"
  },
  "keywords": [
    "streaming",
    "self-hosted",
    "media-server",
    "docker",
    "typescript"
  ],
  "author": "Enrico Jaupi",
  "license": "CC-BY-NC-SA-4.0",
  "type": "module",
  "devDependencies": {
    "@ffmpeg/ffmpeg": "0.12.10",
    "@ffmpeg/util": "0.12.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.33",
    "@tanstack/react-query": "^5.103.2",
    "@types/express": "^5.0.6",
    "@types/hls.js": "^0.13.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^25.6.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "nodemon": "^3.1.14",
    "postcss": "^8.5.28",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.17",
    "typescript": "^6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "@types/ws": "^8.18.1",
    "axios": "^1.18.1",
    "axios-cookiejar-support": "^6.0.5",
    "bcrypt": "^6.0.0",
    "cheerio": "^1.2.0",
    "cookie-parser": "^1.4.7",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "hls.js": "^1.6.16",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.3.0",
    "node-fetch": "^3.3.2",
    "nodemailer": "^9.1.1",
    "pg": "^8.21.0",
    "playwright": "^1.61.1",
    "redis": "^6.0.0",
    "resend": "^6.14.0",
    "theintrodb": "^4.0.0",
    "tough-cookie": "^6.0.1",
    "undici": "^7.29.0",
    "ws": "^8.21.1"
  }
}
